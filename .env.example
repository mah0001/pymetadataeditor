# Copy to ".env" in the project root and fill in real values.
# cp .env.example .env

# Metadata Editor API (preferred names; see pymetadataeditor.MetadataEditor docstring)
METADATA_API_URL=https://your-metadata-host.example.org/index.php/api
METADATA_API_KEY=your_api_key_here

# Alternate names used in README, demos, and tests
API_URL=https://your-metadata-host.example.org/index.php/api
API_KEY=your_api_key_here

# Optional: LLM features (see docs/using_automated_metadata_creation.md)
# OPENAI_KEY=
# API_KEY_FOR_AZURE_INSTANCE_OF_LLM=
